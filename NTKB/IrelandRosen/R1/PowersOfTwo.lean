import Mathlib.RingTheory.ZMod.UnitsCyclic
import Mathlib.GroupTheory.SpecificGroups.Cyclic
import Mathlib.GroupTheory.Index
import NTKB.Attr

/-!
# Ireland–Rosen, Chapter 4, Section 2: `n`-th power residues modulo `2^e`

* **Proposition 4.2.2.** Let `a` be odd and `e ≥ 3`. If `n` is odd, `x^n ≡ a (mod 2^e)` has
  exactly one solution. If `n` is even, it is solvable iff `a ≡ 1 (mod 4)` and
  `a^(2^(e-2)/d) ≡ 1 (mod 2^e)`, `d = (n, 2^(e-2))`, and then it has exactly `2d` solutions.
* **Proposition 4.2.4.** If `2^t` is the exact power of `2` dividing `n`, `a` is odd and
  `x^n ≡ a (mod 2^(2t+1))` is solvable, then `x^n ≡ a (mod 2^e)` is solvable for every
  `e ≥ 2t + 1`, with the same number of solutions.

The book leaves both proofs as an exercise (Exercise 25), with the hint to write
`a = (-1)^s 5^t` and `x = (-1)^y 5^z`. We use the corresponding structure of `(ℤ/2^eℤ)ˣ`:
the subgroup `H` generated by `5` is cyclic of order `2^(e-2)` (Mathlib's
`ZMod.orderOf_unitFive`) and every unit is `h` or `-h` with `h ∈ H`. Solutions are counted
in `ZMod (2^e)`.
-/

open ZMod

namespace NTKB.IrelandRosen

/-- For a unit `a` and `n ≠ 0`, the solutions of `x^n = a` are units. -/
noncomputable def powSolutionsEquivUnits {M : Type*} [CommMonoid M] {n : ℕ} (hn : n ≠ 0)
    (a : Mˣ) :
    {u : Mˣ // u ^ n = a} ≃ {x : M // x ^ n = a} where
  toFun u := ⟨u.1, by rw [← Units.val_pow_eq_pow_val, u.2]⟩
  invFun x := ⟨((isUnit_pow_iff hn).mp (x.2 ▸ a.isUnit)).unit, by ext; simp [x.2]⟩
  left_inv u := by ext; rfl
  right_inv x := by ext; rfl

/-- An odd integer is a unit modulo `2^e`. -/
theorem isUnit_intCast_of_odd {e : ℕ} (he : 1 ≤ e) {a : ℤ} (ha : Odd a) :
    IsUnit (a : ZMod (2 ^ e)) := by
  have hnat : IsUnit ((a.natAbs : ℕ) : ZMod (2 ^ e)) := by
    rw [isUnit_natCast_iff_not_dvd_pow Nat.prime_two he, ← Int.natCast_dvd_natCast,
      Int.natCast_natAbs, dvd_abs]
    exact fun h ↦ (Int.not_even_iff_odd.mpr ha) (even_iff_two_dvd.mpr h)
  rcases Int.natAbs_eq a with h | h
  · rw [h, Int.cast_natCast]; exact hnat
  · rw [h, Int.cast_neg, Int.cast_natCast]; exact hnat.neg

/-- `a` as a unit of `ZMod (2^e)`. -/
noncomputable def oddUnit {e : ℕ} (he : 1 ≤ e) {a : ℤ} (ha : Odd a) : (ZMod (2 ^ e))ˣ :=
  (isUnit_intCast_of_odd he ha).unit

@[simp]
theorem val_oddUnit {e : ℕ} (he : 1 ≤ e) {a : ℤ} (ha : Odd a) :
    (oddUnit he ha : ZMod (2 ^ e)) = a := rfl

theorem card_units_two_pow {e : ℕ} (he : 1 ≤ e) : Nat.card (ZMod (2 ^ e))ˣ = 2 ^ (e - 1) := by
  have : NeZero (2 ^ e) := ⟨by positivity⟩
  rw [Nat.card_eq_fintype_card, ZMod.card_units_eq_totient,
    Nat.totient_prime_pow Nat.prime_two (by omega)]
  simp

/-- **Ireland–Rosen, Proposition 4.2.2, `n` odd.** For odd `a` and odd `n`, `x^n ≡ a (mod 2^e)`
has exactly one solution (for every `e ≥ 1`; the book states it for `e ≥ 3`): `x ↦ x^n` is a
bijection of `(ℤ/2^eℤ)ˣ`, a group of order `2^(e-1)` prime to `n`. -/
@[kb "irelandrosen1990" "Prop 4.2.2, p. 56"]
theorem existsUnique_pow_eq_of_odd {e : ℕ} (he : 1 ≤ e) {a : ℤ} (ha : Odd a) {n : ℕ}
    (hn : Odd n) : ∃! x : ZMod (2 ^ e), x ^ n = a := by
  have hcop : (Nat.card (ZMod (2 ^ e))ˣ).Coprime n := by
    rw [card_units_two_pow he]
    exact Nat.Coprime.pow_left _ (Nat.coprime_two_left.mpr hn)
  set f := powCoprime hcop
  set u := f.symm (oddUnit he ha)
  have hu : u ^ n = oddUnit he ha := by
    change f u = _
    simp [u]
  refine ⟨u, by
    show (u : ZMod (2 ^ e)) ^ n = a; rw [← Units.val_pow_eq_pow_val, hu, val_oddUnit],
    fun x hx ↦ ?_⟩
  have hxunit : IsUnit x :=
    (isUnit_pow_iff hn.pos.ne').mp (by rw [hx]; exact isUnit_intCast_of_odd he ha)
  obtain ⟨w, rfl⟩ := hxunit
  congr 1
  apply f.injective
  change w ^ n = u ^ n
  rw [hu]
  ext
  rw [Units.val_pow_eq_pow_val, hx, val_oddUnit]

section Structure

variable {e : ℕ}

/-- The subgroup of `(ℤ/2^eℤ)ˣ` generated by `5`. -/
abbrev fiveSubgroup (e : ℕ) : Subgroup (ZMod (2 ^ e))ˣ := Subgroup.zpowers ZMod.unitFive

theorem card_fiveSubgroup (e : ℕ) : Nat.card (fiveSubgroup e) = 2 ^ (e - 2) := by
  rw [Nat.card_zpowers, orderOf_unitFive]

/-- Reduction modulo `4` on units. -/
noncomputable abbrev modFour (he : 2 ≤ e) : (ZMod (2 ^ e))ˣ →* (ZMod (2 ^ 2))ˣ :=
  ZMod.unitsMap (pow_dvd_pow 2 he)

theorem modFour_of_mem (he : 2 ≤ e) {h : (ZMod (2 ^ e))ˣ} (hh : h ∈ fiveSubgroup e) :
    modFour he h = 1 := by
  obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hh
  rw [map_zpow, ZMod.unitsMap_unitFive, ZMod.unitFive_eq_one le_rfl, one_zpow]

theorem modFour_neg (he : 2 ≤ e) (u : (ZMod (2 ^ e))ˣ) : modFour he (-u) = -modFour he u := by
  rw [← neg_one_mul, map_mul, modFour, ZMod.unitsMap_def, Units.map_neg_one, neg_one_mul]

theorem neg_one_ne_one_four : (-1 : (ZMod (2 ^ 2))ˣ) ≠ 1 := by decide

/-- Every unit modulo `2^e` (`e ≥ 3`) is `h` or `-h` with `h` a power of `5`, and not both. -/
theorem bijective_fiveSubgroup_sum (he : 3 ≤ e) :
    Function.Bijective (Sum.elim (fun h : fiveSubgroup e ↦ (h : (ZMod (2 ^ e))ˣ))
      (fun h : fiveSubgroup e ↦ -(h : (ZMod (2 ^ e))ˣ))) := by
  have he2 : 2 ≤ e := by omega
  refine Function.Injective.bijective_of_nat_card_le ?_ ?_
  · rintro (h1 | h1) (h2 | h2) heq <;> simp only [Sum.elim_inl, Sum.elim_inr] at heq
    · exact congrArg _ (Subtype.ext heq)
    · have := congrArg (modFour he2) heq
      rw [modFour_neg, modFour_of_mem he2 h1.2, modFour_of_mem he2 h2.2] at this
      exact absurd this.symm neg_one_ne_one_four
    · have := congrArg (modFour he2) heq
      rw [modFour_neg, modFour_of_mem he2 h1.2, modFour_of_mem he2 h2.2] at this
      exact absurd this neg_one_ne_one_four
    · exact congrArg _ (Subtype.ext (neg_inj.mp heq))
  · rw [Nat.card_sum, card_fiveSubgroup, card_units_two_pow (by omega), ← two_mul,
      ← pow_succ']
    exact le_of_eq (by congr 1; omega)

theorem mem_or_neg_mem_fiveSubgroup (he : 3 ≤ e) (u : (ZMod (2 ^ e))ˣ) :
    u ∈ fiveSubgroup e ∨ -u ∈ fiveSubgroup e := by
  obtain ⟨s, hs⟩ := (bijective_fiveSubgroup_sum he).2 u
  rcases s with h | h
  · left; rw [← hs]; exact h.2
  · right; rw [← hs]; simp only [Sum.elim_inr, neg_neg]; exact h.2

/-- For even `n`, the number of solutions of `u^n = 1` in `(ℤ/2^eℤ)ˣ` is `2 (2^(e-2), n)`. -/
theorem card_units_pow_eq_one (he : 3 ≤ e) {n : ℕ} (hn : Even n) :
    Nat.card {u : (ZMod (2 ^ e))ˣ // u ^ n = 1} = 2 * Nat.gcd (2 ^ (e - 2)) n := by
  set H := fiveSubgroup e
  set E := Equiv.ofBijective _ (bijective_fiveSubgroup_sum he)
  have h1 : Nat.card {u : (ZMod (2 ^ e))ˣ // u ^ n = 1} =
      Nat.card ({h : H // (h : (ZMod (2 ^ e))ˣ) ^ n = 1} ⊕
        {h : H // (-(h : (ZMod (2 ^ e))ˣ)) ^ n = 1}) := by
    refine Nat.card_congr ((E.subtypeEquiv (p := fun s ↦ (E s) ^ n = 1) fun _ ↦ Iff.rfl).symm.trans
      Equiv.subtypeSum)
  have hker : Nat.card {h : H // (h : (ZMod (2 ^ e))ˣ) ^ n = 1} = Nat.gcd (2 ^ (e - 2)) n := by
    rw [← card_fiveSubgroup e, ← IsCyclic.card_powMonoidHom_ker H n]
    refine Nat.card_congr (Equiv.subtypeEquivRight fun h ↦ ?_)
    rw [MonoidHom.mem_ker, powMonoidHom_apply, ← Subgroup.coe_pow, OneMemClass.coe_eq_one]
  rw [h1, Nat.card_sum, hker]
  simp_rw [hn.neg_pow]
  rw [hker, two_mul]

/-- In the cyclic group `⟨5⟩` of order `N = 2^(e-2)`, the `n`-th powers are exactly the `h` with
`h^(N/d) = 1`, `d = (n, N)`. -/
theorem range_pow_eq_ker_pow (e n : ℕ) :
    (powMonoidHom n : fiveSubgroup e →* fiveSubgroup e).range =
      (powMonoidHom (2 ^ (e - 2) / Nat.gcd n (2 ^ (e - 2))) :
        fiveSubgroup e →* fiveSubgroup e).ker := by
  set H := fiveSubgroup e
  set N := 2 ^ (e - 2) with hN
  have hcard : Nat.card H = N := card_fiveSubgroup e
  set d := Nat.gcd n N
  have hdN : d ∣ N := Nat.gcd_dvd_right n N
  have hdn : d ∣ n := Nat.gcd_dvd_left n N
  apply Subgroup.eq_of_le_of_card_ge
  · rintro _ ⟨x, rfl⟩
    rw [MonoidHom.mem_ker, powMonoidHom_apply, powMonoidHom_apply, ← pow_mul,
      show n * (N / d) = N * (n / d) by
        have hd0 : 0 < d := Nat.gcd_pos_of_pos_right _ (by positivity)
        obtain ⟨A, hA⟩ := hdN
        obtain ⟨B, hB⟩ := hdn
        rw [hA, hB, Nat.mul_div_cancel_left _ hd0, Nat.mul_div_cancel_left _ hd0]
        ring, pow_mul, ← hcard,
      pow_card_eq_one', one_pow]
  · rw [IsCyclic.card_powMonoidHom_ker, IsCyclic.card_powMonoidHom_range, hcard,
      Nat.gcd_comm N n, Nat.gcd_eq_right (Nat.div_dvd_of_dvd hdN)]

/-- Solvability of `u^n = a` in `(ℤ/2^eℤ)ˣ` for even `n`. -/
theorem exists_units_pow_eq_iff (he : 3 ≤ e) {n : ℕ} (hn : Even n) (a : (ZMod (2 ^ e))ˣ) :
    (∃ u : (ZMod (2 ^ e))ˣ, u ^ n = a) ↔
      modFour (by omega) a = 1 ∧ a ^ (2 ^ (e - 2) / Nat.gcd n (2 ^ (e - 2))) = 1 := by
  have he2 : 2 ≤ e := by omega
  set H := fiveSubgroup e
  constructor
  · rintro ⟨u, rfl⟩
    -- `u^n = h^n` with `h = ±u ∈ H`
    obtain ⟨h, hh, hu⟩ : ∃ h ∈ H, u ^ n = h ^ n := by
      rcases mem_or_neg_mem_fiveSubgroup he u with hu | hu
      · exact ⟨u, hu, rfl⟩
      · exact ⟨-u, hu, (hn.neg_pow u).symm⟩
    rw [hu]
    refine ⟨by rw [map_pow, modFour_of_mem he2 hh, one_pow], ?_⟩
    have := (range_pow_eq_ker_pow e n).le ⟨⟨h, hh⟩, rfl⟩
    rw [MonoidHom.mem_ker, powMonoidHom_apply, powMonoidHom_apply] at this
    simpa using congrArg Subtype.val this
  · rintro ⟨h4, hpow⟩
    have ha : a ∈ H := by
      rcases mem_or_neg_mem_fiveSubgroup he a with ha | ha
      · exact ha
      · have := modFour_of_mem he2 ha
        rw [modFour_neg, h4] at this
        exact absurd this neg_one_ne_one_four
    have hk : (⟨a, ha⟩ : H) ∈ (powMonoidHom (2 ^ (e - 2) / Nat.gcd n (2 ^ (e - 2))) :
        H →* H).ker := by
      rw [MonoidHom.mem_ker, powMonoidHom_apply]
      exact Subtype.ext (by simpa using hpow)
    rw [← range_pow_eq_ker_pow] at hk
    obtain ⟨x, hx⟩ := hk
    exact ⟨x, by simpa using congrArg Subtype.val hx⟩

/-- For even `n`, if `u^n = a` is solvable then it has `2 (2^(e-2), n)` solutions. -/
theorem card_units_pow_eq (he : 3 ≤ e) {n : ℕ} (hn : Even n) {a : (ZMod (2 ^ e))ˣ}
    (ha : ∃ u : (ZMod (2 ^ e))ˣ, u ^ n = a) :
    Nat.card {u : (ZMod (2 ^ e))ˣ // u ^ n = a} = 2 * Nat.gcd (2 ^ (e - 2)) n := by
  classical
  rw [← card_units_pow_eq_one he hn, Nat.card_eq_fintype_card, Nat.card_eq_fintype_card,
    Fintype.card_subtype, Fintype.card_subtype]
  obtain ⟨u, hu⟩ := ha
  exact MonoidHom.card_fiber_eq_of_mem_range (powMonoidHom n) ⟨u, hu⟩ ⟨1, one_pow n⟩

end Structure

/-- `a ≡ 1 (mod 4)` in terms of `modFour`. -/
theorem modFour_oddUnit_eq_one_iff {e : ℕ} (he : 3 ≤ e) {a : ℤ} (ha : Odd a) :
    modFour (by omega : 2 ≤ e) (oddUnit (by omega) ha) = 1 ↔ a ≡ 1 [ZMOD 4] := by
  rw [Units.ext_iff, ZMod.unitsMap_val, val_oddUnit, Units.val_one,
    ZMod.cast_intCast (pow_dvd_pow 2 (by omega : 2 ≤ e)), ← Int.cast_one,
    ZMod.intCast_eq_intCast_iff]
  norm_num

/-- **Ireland–Rosen, Proposition 4.2.2, `n` even: solvability.** For odd `a`, `e ≥ 3` and even
`n > 0`, `x^n ≡ a (mod 2^e)` is solvable iff `a ≡ 1 (mod 4)` and `a^(2^(e-2)/d) ≡ 1 (mod 2^e)`,
`d = (n, 2^(e-2))`. -/
@[kb "irelandrosen1990" "Prop 4.2.2, p. 56"]
theorem exists_pow_eq_iff_of_even {e : ℕ} (he : 3 ≤ e) {a : ℤ} (ha : Odd a) {n : ℕ}
    (hn0 : 0 < n) (hn : Even n) :
    (∃ x : ZMod (2 ^ e), x ^ n = a) ↔
      a ≡ 1 [ZMOD 4] ∧ (a : ZMod (2 ^ e)) ^ (2 ^ (e - 2) / Nat.gcd n (2 ^ (e - 2))) = 1 := by
  set au := oddUnit (by omega : 1 ≤ e) ha
  have hE := powSolutionsEquivUnits hn0.ne' au
  rw [← modFour_oddUnit_eq_one_iff he ha]
  have h1 : (∃ x : ZMod (2 ^ e), x ^ n = a) ↔ ∃ u : (ZMod (2 ^ e))ˣ, u ^ n = au := by
    constructor
    · rintro ⟨x, hx⟩
      exact ⟨(hE.symm ⟨x, hx⟩).1, (hE.symm ⟨x, hx⟩).2⟩
    · rintro ⟨u, hu⟩
      exact ⟨(hE ⟨u, hu⟩).1, (hE ⟨u, hu⟩).2⟩
  rw [h1, exists_units_pow_eq_iff he hn]
  refine and_congr Iff.rfl ?_
  rw [Units.ext_iff, Units.val_pow_eq_pow_val, val_oddUnit, Units.val_one]

/-- **Ireland–Rosen, Proposition 4.2.2, `n` even: number of solutions.** For odd `a`, `e ≥ 3`
and even `n > 0`, if `x^n ≡ a (mod 2^e)` is solvable then it has exactly `2d` solutions,
`d = (n, 2^(e-2))`. -/
@[kb "irelandrosen1990" "Prop 4.2.2, p. 56"]
theorem card_pow_eq_of_even {e : ℕ} (he : 3 ≤ e) {a : ℤ} (ha : Odd a) {n : ℕ} (hn0 : 0 < n)
    (hn : Even n) (hsol : ∃ x : ZMod (2 ^ e), x ^ n = a) :
    Nat.card {x : ZMod (2 ^ e) // x ^ n = a} = 2 * Nat.gcd n (2 ^ (e - 2)) := by
  set au := oddUnit (by omega : 1 ≤ e) ha
  have hE := powSolutionsEquivUnits hn0.ne' au
  show Nat.card {x : ZMod (2 ^ e) // x ^ n = (au : ZMod (2 ^ e))} = _
  rw [← Nat.card_congr hE, card_units_pow_eq he hn, Nat.gcd_comm]
  obtain ⟨x, hx⟩ := hsol
  exact ⟨(hE.symm ⟨x, hx⟩).1, (hE.symm ⟨x, hx⟩).2⟩

/-- If `2^t` is the exact power of `2` dividing `n` and `t ≤ k`, then `(n, 2^k) = 2^t`. -/
theorem gcd_two_pow_eq {n t k : ℕ} (ht : 2 ^ t ∣ n) (ht' : ¬ 2 ^ (t + 1) ∣ n) (htk : t ≤ k) :
    Nat.gcd n (2 ^ k) = 2 ^ t := by
  obtain ⟨j, hjk, hj⟩ := (Nat.dvd_prime_pow Nat.prime_two).mp (Nat.gcd_dvd_right n (2 ^ k))
  rw [hj]
  have h1 : 2 ^ t ∣ 2 ^ j := hj ▸ Nat.dvd_gcd ht (Nat.pow_dvd_pow 2 htk)
  have h2 : 2 ^ j ∣ n := hj ▸ Nat.gcd_dvd_left n (2 ^ k)
  have htj := (Nat.pow_dvd_pow_iff_le_right (by norm_num)).mp h1
  have hjt : j ≤ t := by
    by_contra hlt
    exact ht' ((Nat.pow_dvd_pow 2 (by omega)).trans h2)
  rw [le_antisymm hjt htj]

/-- If `b ≡ 1 (mod 2^k)` with `k ≥ 1` then `b^(2^j) ≡ 1 (mod 2^(k+j))`. -/
theorem two_pow_dvd_pow_two_pow_sub_one {b : ℤ} {k : ℕ} (hk : 1 ≤ k) (hb : 2 ^ k ∣ b - 1)
    (j : ℕ) : 2 ^ (k + j) ∣ b ^ 2 ^ j - 1 := by
  induction j with
  | zero => simpa using hb
  | succ j ih =>
    have hodd : (2 : ℤ) ∣ b ^ 2 ^ j + 1 := by
      have : (2 : ℤ) ∣ b ^ 2 ^ j - 1 := (dvd_pow_self 2 (by omega)).trans
        ((pow_dvd_pow 2 (by omega : 1 ≤ k + j)).trans ih)
      have := dvd_add this (dvd_refl 2)
      ring_nf at this ⊢
      exact this
    rw [pow_succ, pow_mul, sq, ← add_assoc, pow_succ]
    have := mul_dvd_mul ih hodd
    rw [show (b ^ 2 ^ j - 1) * (b ^ 2 ^ j + 1) = b ^ 2 ^ j * b ^ 2 ^ j - 1 by ring] at this
    exact this

/-- `(a : ZMod m)^k = 1` iff `m ∣ a^k - 1`. -/
theorem intCast_pow_eq_one_iff {m : ℕ} {a : ℤ} {k : ℕ} :
    (a : ZMod m) ^ k = 1 ↔ (m : ℤ) ∣ a ^ k - 1 := by
  rw [← Int.cast_pow, ← Int.cast_one, ZMod.intCast_eq_intCast_iff_dvd_sub, dvd_sub_comm]

theorem nat_card_eq_one_of_existsUnique {α : Type*} {p : α → Prop} (h : ∃! x, p x) :
    Nat.card {x // p x} = 1 := by
  obtain ⟨x, hx, huniq⟩ := h
  rw [Nat.card_eq_one_iff_unique]
  exact ⟨⟨fun a b ↦ Subtype.ext ((huniq a a.2).trans (huniq b b.2).symm)⟩, ⟨⟨x, hx⟩⟩⟩

/-- **Ireland–Rosen, Proposition 4.2.4.** Let `2^t` be the exact power of `2` dividing `n > 0`,
`a` odd, and suppose `x^n ≡ a (mod 2^(2t+1))` is solvable. Then `x^n ≡ a (mod 2^e)` is solvable
for every `e ≥ 2t + 1`, with the same number of solutions as modulo `2^(2t+1)`. Proof: for
`t = 0` there is exactly one solution (Proposition 4.2.2); for `t ≥ 1` the criterion of
Proposition 4.2.2 lifts (`b ≡ 1 (mod 2^k)` implies `b^2 ≡ 1 (mod 2^(k+1))`) and the number of
solutions `2 (n, 2^(e-2)) = 2^(t+1)` does not depend on `e`. -/
@[kb "irelandrosen1990" "Prop 4.2.4, p. 57"]
theorem exists_pow_eq_and_card_of_two_pow {n t : ℕ} (hn0 : 0 < n) (ht : 2 ^ t ∣ n)
    (ht' : ¬ 2 ^ (t + 1) ∣ n) {a : ℤ} (ha : Odd a)
    (hsol : ∃ x : ZMod (2 ^ (2 * t + 1)), x ^ n = a) {e : ℕ} (he : 2 * t + 1 ≤ e) :
    (∃ x : ZMod (2 ^ e), x ^ n = a) ∧
      Nat.card {x : ZMod (2 ^ e) // x ^ n = a} =
        Nat.card {x : ZMod (2 ^ (2 * t + 1)) // x ^ n = a} := by
  rcases Nat.eq_zero_or_pos t with rfl | htpos
  · -- `n` odd: one solution for every `e ≥ 1`
    have hnodd : Odd n := Nat.odd_iff.mpr (by simpa [Nat.two_dvd_ne_zero] using ht')
    have h1 := existsUnique_pow_eq_of_odd (by omega : 1 ≤ e) ha hnodd
    have h2 := existsUnique_pow_eq_of_odd (by omega : 1 ≤ 2 * 0 + 1) ha hnodd
    exact ⟨h1.exists, by rw [nat_card_eq_one_of_existsUnique h1,
      nat_card_eq_one_of_existsUnique h2]⟩
  -- `n` even
  have hneven : Even n := even_iff_two_dvd.mpr ((pow_dvd_pow 2 htpos).trans (by simpa using ht))
  have hE : 3 ≤ 2 * t + 1 := by omega
  have he3 : 3 ≤ e := by omega
  have hgE : Nat.gcd n (2 ^ (2 * t + 1 - 2)) = 2 ^ t := gcd_two_pow_eq ht ht' (by omega)
  have hge : Nat.gcd n (2 ^ (e - 2)) = 2 ^ t := gcd_two_pow_eq ht ht' (by omega)
  have hsolve : ∃ x : ZMod (2 ^ e), x ^ n = a := by
    obtain ⟨h4, hpow⟩ := (exists_pow_eq_iff_of_even hE ha hn0 hneven).mp hsol
    refine (exists_pow_eq_iff_of_even he3 ha hn0 hneven).mpr ⟨h4, ?_⟩
    rw [hgE, Nat.pow_div (by omega) (by norm_num), intCast_pow_eq_one_iff] at hpow
    rw [hge, Nat.pow_div (by omega) (by norm_num), intCast_pow_eq_one_iff]
    -- `a^(2^(t-1)) ≡ 1 (mod 2^(2t+1))` lifts to `a^(2^(e-2-t)) ≡ 1 (mod 2^e)`
    have := two_pow_dvd_pow_two_pow_sub_one (b := a ^ 2 ^ (2 * t + 1 - 2 - t)) (k := 2 * t + 1)
      (by omega)
      (by exact_mod_cast hpow) (e - (2 * t + 1))
    rw [← pow_mul, ← pow_add, show 2 * t + 1 - 2 - t + (e - (2 * t + 1)) = e - 2 - t by omega,
      show 2 * t + 1 + (e - (2 * t + 1)) = e by omega] at this
    exact_mod_cast this
  refine ⟨hsolve, ?_⟩
  rw [card_pow_eq_of_even he3 ha hn0 hneven hsolve, card_pow_eq_of_even hE ha hn0 hneven hsol,
    hge, hgE]

end NTKB.IrelandRosen
