import NTKB.Attr
import NTKB.Elementary.NZM.FloorAndMatrices
import Mathlib.Data.Matrix.Basis
import Mathlib.LinearAlgebra.Matrix.Determinant.Basic

/-!
# Unimodular matrices are products of elementary matrices
(Niven–Zuckerman–Montgomery, §5.2)

* Theorem 5.3 (iii)/(iv): `unimodularElementaryProduct` proves the named proposition
  `UnimodularElementaryProduct` of `FloorAndMatrices`, by a column-by-column Gauss–Jordan
  elimination over `ℤ` using the Euclidean algorithm.
-/

namespace NTKB.NZM

open Matrix

variable {n : Type*} [Fintype n] [DecidableEq n]

/-- Adding `c` times row `j` to row `i` (the matrix is the one used in `elementaryMatrices`). -/
def tvM (i j : n) (c : ℤ) : Matrix n n ℤ :=
  1 + Matrix.of fun a b => if a = i ∧ b = j then c else 0

/-- Swapping two rows. -/
def swM (i j : n) : Matrix n n ℤ := Matrix.of fun a b => if Equiv.swap i j a = b then 1 else 0

/-- Negating a row. -/
def ngM (i : n) : Matrix n n ℤ := Matrix.diagonal (Function.update (1 : n → ℤ) i (-1))

lemma tvM_mul_apply (i j : n) (c : ℤ) (M : Matrix n n ℤ) (a b : n) :
    (tvM i j c * M) a b = M a b + if a = i then c * M j b else 0 := by
  rw [tvM, add_mul, one_mul, Matrix.add_apply]
  congr 1
  rw [Matrix.mul_apply]
  by_cases h : a = i
  · subst h; simp
  · simp [h]

omit [Fintype n] in
lemma tvM_zero (i j : n) : tvM i j 0 = 1 := by
  ext a b; simp [tvM]

lemma swM_mul_apply (i j : n) (M : Matrix n n ℤ) (a b : n) :
    (swM i j * M) a b = M (Equiv.swap i j a) b := by
  simp [swM, Matrix.mul_apply]

lemma ngM_mul_apply (i : n) (M : Matrix n n ℤ) (a b : n) :
    (ngM i * M) a b = if a = i then -M a b else M a b := by
  simp only [ngM, Matrix.diagonal_mul]
  by_cases h : a = i
  · subst h; simp
  · simp [h]

/-- The submonoid generated by the elementary matrices. -/
abbrev elemMonoid (n : Type*) [Fintype n] [DecidableEq n] : Submonoid (Matrix n n ℤ) :=
  Submonoid.closure (elementaryMatrices n)

lemma tvM_mem {i j : n} (h : i ≠ j) (c : ℤ) : tvM i j c ∈ elemMonoid n :=
  Submonoid.subset_closure (Or.inl ⟨i, j, c, h, rfl⟩)

lemma swM_mem {i j : n} (h : i ≠ j) : swM i j ∈ elemMonoid n :=
  Submonoid.subset_closure (Or.inr (Or.inl ⟨i, j, h, rfl⟩))

lemma ngM_mem (i : n) : ngM i ∈ elemMonoid n :=
  Submonoid.subset_closure (Or.inr (Or.inr ⟨i, rfl⟩))

lemma tvM_mul_tvM (i j : n) (c d : ℤ) (h : i ≠ j) : tvM i j c * tvM i j d = tvM i j (c + d) := by
  ext a b
  rw [tvM_mul_apply]
  have hji : ¬ j = i := h.symm
  by_cases ha : a = i <;> by_cases hb : b = j <;> by_cases hab : a = b <;>
    simp [tvM, Matrix.one_apply, ha, hb, hab, hji] <;>
    first | (intro h; exact absurd h.symm hb) | (intro _ h; exact absurd h.symm hb) | ring

lemma swM_mul_swM (i j : n) : swM i j * swM i j = 1 := by
  ext a b
  rw [swM_mul_apply]
  simp [swM, Matrix.one_apply]

lemma ngM_mul_ngM (i : n) : ngM i * ngM i = 1 := by
  simp only [ngM, Matrix.diagonal_mul_diagonal]
  rw [← Matrix.diagonal_one]
  congr 1
  funext a
  by_cases h : a = i <;> simp [h]

/-- Every element of the monoid generated by elementary matrices has an inverse in it. -/
lemma exists_inv_of_mem {P : Matrix n n ℤ} (hP : P ∈ elemMonoid n) :
    ∃ Q ∈ elemMonoid n, Q * P = 1 ∧ P * Q = 1 := by
  induction hP using Submonoid.closure_induction with
  | mem x hx =>
    rcases hx with ⟨i, j, c, hij, rfl⟩ | ⟨i, j, hij, rfl⟩ | ⟨i, rfl⟩
    · refine ⟨tvM i j (-c), tvM_mem hij _, ?_, ?_⟩
      · have := tvM_mul_tvM i j (-c) c hij
        rw [neg_add_cancel, tvM_zero] at this
        exact this
      · have := tvM_mul_tvM i j c (-c) hij
        rw [add_neg_cancel, tvM_zero] at this
        exact this
    · exact ⟨_, swM_mem hij, swM_mul_swM i j, swM_mul_swM i j⟩
    · exact ⟨_, ngM_mem i, ngM_mul_ngM i, ngM_mul_ngM i⟩
  | one => exact ⟨1, one_mem _, by simp, by simp⟩
  | mul x y _ _ hx hy =>
    obtain ⟨Qx, hQx, h1, h2⟩ := hx
    obtain ⟨Qy, hQy, h3, h4⟩ := hy
    refine ⟨Qy * Qx, mul_mem hQy hQx, ?_, ?_⟩
    · calc Qy * Qx * (x * y) = Qy * (Qx * x) * y := by simp only [mul_assoc]
        _ = 1 := by rw [h1]; simpa using h3
    · calc x * y * (Qy * Qx) = x * (y * Qy) * Qx := by simp only [mul_assoc]
        _ = 1 := by rw [h4]; simpa using h2

lemma isUnit_of_mem {P : Matrix n n ℤ} (hP : P ∈ elemMonoid n) : IsUnit P := by
  obtain ⟨Q, -, h1, h2⟩ := exists_inv_of_mem hP
  exact ⟨⟨P, Q, h2, h1⟩, rfl⟩

/-! ### Gauss–Jordan elimination over `ℤ` -/

/-- The columns indexed by `s` of `M` are those of the identity matrix. -/
def ColDone (s : Finset n) (M : Matrix n n ℤ) : Prop :=
  ∀ c ∈ s, ∀ j, M j c = (1 : Matrix n n ℤ) j c

lemma colDone_tv {s : Finset n} {M : Matrix n n ℤ} (hM : ColDone s M) {k : n} (hk : k ∉ s)
    (j : n) (c : ℤ) : ColDone s (tvM j k c * M) := by
  intro b hb a
  have hkb : k ≠ b := fun h => hk (h ▸ hb)
  rw [tvM_mul_apply, hM b hb a, hM b hb k]
  simp [Matrix.one_apply, hkb]

lemma colDone_sw {s : Finset n} {M : Matrix n n ℤ} (hM : ColDone s M) {i j : n} (hi : i ∉ s)
    (hj : j ∉ s) : ColDone s (swM i j * M) := by
  intro b hb a
  have hbi : b ≠ i := fun h => hi (h ▸ hb)
  have hbj : b ≠ j := fun h => hj (h ▸ hb)
  rw [swM_mul_apply, hM b hb]
  simp [Matrix.one_apply, Equiv.swap_apply_eq_iff, Equiv.swap_apply_of_ne_of_ne hbi hbj]

lemma colDone_ng {s : Finset n} {M : Matrix n n ℤ} (hM : ColDone s M) {i : n} (hi : i ∉ s) :
    ColDone s (ngM i * M) := by
  intro b hb a
  have hib : i ≠ b := fun h => hi (h ▸ hb)
  rw [ngM_mul_apply, hM b hb a]
  by_cases h : a = i
  · subst h; simp [hib]
  · simp [h]

lemma exists_coprime_col {s : Finset n} {M : Matrix n n ℤ} (hM : ColDone s M) (hu : IsUnit M)
    {i0 : n} (hi0 : i0 ∉ s) : ∃ a : n → ℤ, ∑ j ∈ sᶜ, a j * M j i0 = 1 := by
  obtain ⟨V, hV⟩ := hu.exists_left_inv
  have hc : ∀ c ∈ s, ∀ j, V j c = (1 : Matrix n n ℤ) j c := by
    intro c hc j
    have h1 : (V * M) j c = (1 : Matrix n n ℤ) j c := by rw [hV]
    rw [Matrix.mul_apply] at h1
    have e : ∑ k, V j k * M k c = ∑ k, V j k * (1 : Matrix n n ℤ) k c :=
      Finset.sum_congr rfl fun k _ => by rw [hM c hc k]
    rw [e, ← Matrix.mul_apply, Matrix.mul_one] at h1
    exact h1
  refine ⟨fun j => V i0 j, ?_⟩
  have h1 : (V * M) i0 i0 = 1 := by rw [hV]; simp
  rw [Matrix.mul_apply] at h1
  rw [← h1]
  show ∑ j ∈ sᶜ, V i0 j * M j i0 = _
  apply Finset.sum_subset (Finset.subset_univ _)
  intro j _ hj
  have hjs : j ∈ s := by simpa using hj
  rw [hc j hjs i0]
  have : i0 ≠ j := fun h => hi0 (h ▸ hjs)
  simp [Matrix.one_apply, this]

/-- The Euclidean-algorithm step: by row operations among the rows outside `s`, the entries of
column `i0` in the rows outside `s` other than `i0` are cleared. -/
lemma euclid_step {s : Finset n} {i0 : n} (hi0 : i0 ∉ s) :
    ∀ N : ℕ, ∀ M : Matrix n n ℤ, ∑ j ∈ sᶜ, (M j i0).natAbs = N → ColDone s M → IsUnit M →
      ∃ P ∈ elemMonoid n, ColDone s (P * M) ∧ ∀ j ∉ s, j ≠ i0 → (P * M) j i0 = 0 := by
  intro N
  induction N using Nat.strong_induction_on with
  | _ N ih =>
  intro M hN hD hU
  obtain ⟨a, ha⟩ := exists_coprime_col hD hU hi0
  have hZne : (sᶜ.filter (fun j => M j i0 ≠ 0)).Nonempty := by
    by_contra hne
    rw [Finset.not_nonempty_iff_eq_empty, Finset.filter_eq_empty_iff] at hne
    have : ∑ j ∈ sᶜ, a j * M j i0 = 0 := by
      apply Finset.sum_eq_zero
      intro j hj
      have := hne hj
      simp_all
    omega
  obtain ⟨k, hkZ, hkmin⟩ :=
    Finset.exists_min_image (sᶜ.filter (fun j => M j i0 ≠ 0)) (fun j => (M j i0).natAbs) hZne
  have hkZ' := Finset.mem_filter.1 hkZ
  have hks : k ∉ s := by simpa using hkZ'.1
  by_cases hex : ∃ j ∈ sᶜ.filter (fun j => M j i0 ≠ 0), j ≠ k
  · obtain ⟨j, hjZ, hjk⟩ := hex
    have hjZ' := Finset.mem_filter.1 hjZ
    have hjs : j ∉ s := by simpa using hjZ'.1
    have hmin := hkmin j hjZ
    set q := M j i0 / M k i0 with hq
    have hM' : ∀ x, (tvM j k (-q) * M) x i0 = if x = j then M j i0 - q * M k i0 else M x i0 := by
      intro x
      rw [tvM_mul_apply]
      by_cases hx : x = j
      · subst hx; simp; ring
      · simp [hx]
    have hlt : ∑ x ∈ sᶜ, ((tvM j k (-q) * M) x i0).natAbs < N := by
      rw [← hN]
      apply Finset.sum_lt_sum
      · intro x _
        rw [hM' x]
        split_ifs with hx
        · subst hx
          have e : M x i0 - q * M k i0 = M x i0 % M k i0 := by
            rw [hq]; rw [Int.emod_def]; ring
          rw [e]
          have h1 := Int.emod_nonneg (M x i0) hkZ'.2
          have h2 := Int.emod_lt (M x i0) hkZ'.2
          omega
        · exact le_refl _
      · refine ⟨j, by simpa using hjs, ?_⟩
        rw [hM' j, if_pos rfl]
        have e : M j i0 - q * M k i0 = M j i0 % M k i0 := by
          rw [hq]; rw [Int.emod_def]; ring
        rw [e]
        have h1 := Int.emod_nonneg (M j i0) hkZ'.2
        have h2 := Int.emod_lt (M j i0) hkZ'.2
        omega
    have hU' : IsUnit (tvM j k (-q) * M) := (isUnit_of_mem (tvM_mem hjk _)).mul hU
    obtain ⟨P, hP, h1, h2⟩ := ih _ hlt _ rfl (colDone_tv hD hks j (-q)) hU'
    exact ⟨P * tvM j k (-q), mul_mem hP (tvM_mem hjk _), by simpa [mul_assoc] using h1,
      by simpa [mul_assoc] using h2⟩
  · push_neg at hex
    have hz : ∀ j ∉ s, j ≠ k → M j i0 = 0 := by
      intro j hj hjk
      by_contra h
      exact hjk (hex j (by simp [hj, h]))
    by_cases hk : k = i0
    · refine ⟨1, one_mem _, by simpa using hD, ?_⟩
      intro j hj hji
      rw [one_mul]
      exact hz j hj (hk ▸ hji)
    · refine ⟨swM k i0, swM_mem hk, colDone_sw hD hks hi0, ?_⟩
      intro j hj hji
      rw [swM_mul_apply]
      by_cases hjk : j = k
      · subst hjk
        simp only [Equiv.swap_apply_left]
        exact hz i0 hi0 (Ne.symm hk)
      · rw [Equiv.swap_apply_of_ne_of_ne hjk hji]
        exact hz j hj hjk

/-- Clearing the remaining entries of column `i0` using the pivot `1` in row `i0`. -/
lemma clear_step {s : Finset n} {i0 : n} (hi0 : i0 ∉ s) :
    ∀ N : ℕ, ∀ M : Matrix n n ℤ, (Finset.univ.filter (fun j => j ≠ i0 ∧ M j i0 ≠ 0)).card = N →
      ColDone s M → M i0 i0 = 1 →
      ∃ P ∈ elemMonoid n, ColDone s (P * M) ∧ ∀ j, (P * M) j i0 = (1 : Matrix n n ℤ) j i0 := by
  intro N
  induction N using Nat.strong_induction_on with
  | _ N ih =>
  intro M hN hD hp
  by_cases hbad : ∃ j, j ≠ i0 ∧ M j i0 ≠ 0
  · obtain ⟨j, hji, hj⟩ := hbad
    set x := M j i0 with hx
    have hM' : ∀ a, (tvM j i0 (-x) * M) a i0 = if a = j then 0 else M a i0 := by
      intro a
      rw [tvM_mul_apply]
      by_cases ha : a = j
      · subst ha; simp [hp, hx]
      · simp [ha]
    have hlt : (Finset.univ.filter
        (fun a => a ≠ i0 ∧ (tvM j i0 (-x) * M) a i0 ≠ 0)).card < N := by
      rw [← hN]
      apply Finset.card_lt_card
      rw [Finset.ssubset_iff_of_subset]
      · refine ⟨j, by simpa [hji, hx] using hj, ?_⟩
        simp [hM']
      · intro a ha
        simp only [Finset.mem_filter, Finset.mem_univ, true_and] at ha ⊢
        refine ⟨ha.1, ?_⟩
        have := ha.2
        rw [hM'] at this
        split_ifs at this
        · exact absurd rfl this
        · exact this
    obtain ⟨P, hP, h1, h2⟩ := ih _ hlt _ rfl (colDone_tv hD hi0 j (-x))
      (by rw [tvM_mul_apply]; simp [Ne.symm hji, hp])
    exact ⟨P * tvM j i0 (-x), mul_mem hP (tvM_mem hji _), by simpa [mul_assoc] using h1,
      by simpa [mul_assoc] using h2⟩
  · push_neg at hbad
    refine ⟨1, one_mem _, by simpa using hD, ?_⟩
    intro j
    rw [one_mul]
    by_cases hj : j = i0
    · subst hj; simp [hp]
    · simp [Matrix.one_apply, hj, hbad j hj]

lemma mem_of_colDone : ∀ N : ℕ, ∀ s : Finset n, sᶜ.card = N → ∀ M : Matrix n n ℤ,
    ColDone s M → IsUnit M → M ∈ elemMonoid n := by
  intro N
  induction N with
  | zero =>
    intro s hs M hD _
    have : s = Finset.univ := by
      rw [Finset.card_eq_zero, Finset.compl_eq_empty_iff] at hs
      exact hs
    subst this
    have : M = 1 := by
      ext a b
      exact hD b (Finset.mem_univ _) a
    rw [this]; exact one_mem _
  | succ N ih =>
    intro s hs M hD hU
    obtain ⟨i0, hi0⟩ : sᶜ.Nonempty := Finset.card_pos.1 (by omega)
    have hi0s : i0 ∉ s := by simpa using hi0
    obtain ⟨P1, hP1, hD1, hz1⟩ := euclid_step hi0s _ M rfl hD hU
    have hU1 : IsUnit (P1 * M) := (isUnit_of_mem hP1).mul hU
    obtain ⟨a, ha⟩ := exists_coprime_col hD1 hU1 hi0s
    have hsum : ∑ j ∈ sᶜ, a j * (P1 * M) j i0 = a i0 * (P1 * M) i0 i0 := by
      apply Finset.sum_eq_single i0
      · intro j hj hji
        rw [hz1 j (by simpa using hj) hji, mul_zero]
      · intro h; exact absurd hi0 h
    rw [hsum] at ha
    have hc : (P1 * M) i0 i0 = 1 ∨ (P1 * M) i0 i0 = -1 :=
      Int.isUnit_iff.1 (IsUnit.of_mul_eq_one _ (by rw [mul_comm]; exact ha))
    obtain ⟨P2, hP2, hD2, hp2⟩ : ∃ P2 ∈ elemMonoid n, ColDone s (P2 * (P1 * M)) ∧
        (P2 * (P1 * M)) i0 i0 = 1 := by
      rcases hc with h | h
      · exact ⟨1, one_mem _, by simpa using hD1, by simpa using h⟩
      · refine ⟨ngM i0, ngM_mem i0, colDone_ng hD1 hi0s, ?_⟩
        rw [ngM_mul_apply, if_pos rfl, h]; simp
    obtain ⟨P3, hP3, hD3, hcol⟩ := clear_step hi0s _ _ rfl hD2 hp2
    have hD4 : ColDone (insert i0 s) (P3 * (P2 * (P1 * M))) := by
      intro c hc j
      rcases Finset.mem_insert.1 hc with rfl | hc
      · exact hcol j
      · exact hD3 c hc j
    have hU4 : IsUnit (P3 * (P2 * (P1 * M))) :=
      (isUnit_of_mem hP3).mul ((isUnit_of_mem hP2).mul hU1)
    have hcard : (insert i0 s)ᶜ.card = N := by
      rw [Finset.compl_insert, Finset.card_erase_of_mem hi0]
      omega
    have hmem := ih _ hcard _ hD4 hU4
    obtain ⟨Q, hQ, hQ1, -⟩ := exists_inv_of_mem (mul_mem hP3 (mul_mem hP2 hP1))
    have : M = Q * (P3 * (P2 * (P1 * M))) := by
      calc M = (Q * (P3 * (P2 * P1))) * M := by rw [hQ1, one_mul]
        _ = _ := by simp only [mul_assoc]
    rw [this]
    exact mul_mem hQ hmem

/-- Theorem 5.3 (iii): every unimodular integer matrix is a product of elementary matrices. -/
@[kb "nivenzuckermanmontgomery" "Thm 5.3, p. 227"]
theorem unimodular_mem_closure (U : Matrix n n ℤ) (hU : IsUnimodular U) :
    U ∈ Submonoid.closure (elementaryMatrices n) :=
  mem_of_colDone _ ∅ rfl U (fun c hc => by simp at hc) ((isUnimodular_iff_isUnit U).1 hU)

/-- Theorem 5.3 (iii), in the form of the named proposition of `FloorAndMatrices`. -/
@[kb "nivenzuckermanmontgomery" "Thm 5.3, p. 227"]
theorem unimodularElementaryProduct : UnimodularElementaryProduct :=
  fun _ _ _ U hU => unimodular_mem_closure U hU

end NTKB.NZM
