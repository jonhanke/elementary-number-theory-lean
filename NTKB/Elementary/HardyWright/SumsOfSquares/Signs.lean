/-!
# Hardy–Wright, §§ 21.7–21.8: sums affected with signs, the number `v(k)`

`IsSignedSumOfPowers k s n` says `n = ±x₁ᵏ ± x₂ᵏ ± ⋯ ± x_sᵏ` with non-negative integers `xᵢ`
(the `s` summands are members of the set `0, ±1ᵏ, ±2ᵏ, …` of (21.7.1)); `signedWaringNumber k` is
the book's `v(k)`, the least such `s` that works for every integer `n`.

* Theorem 402: the `(k-1)`th difference of `xᵏ` is `k! x + d` (`exists_sum_choose_pow_eq`).
* Theorems 401 and 403: `v(k)` exists and `v(k) ≤ 2^(k-1) + k!/2`.
* (21.8.1): `v(k) ≤ G(k) + 1`.
* Theorem 404: `v(2) = 3`.
* Theorem 405: `v(3)` is `4` or `5`.
* Theorem 406: `9 ≤ v(4) ≤ 12`.
* Theorem 407: `5 ≤ v(5) ≤ 10`.

The residue facts "every residue (mod 24) is the sum of at most four of `0, ±1, ±9, ±16`" and
"every residue (mod 720) is the sum of two fifth power residues" are checked by explicit witnesses
(generated by `docs/scripts/gen_signs_tables.py`; the 720 cases are checked by `decide +kernel`).
-/

open Finset Filter

namespace NTKB.HardyWright

/-- `n = ±x₁ᵏ ± ⋯ ± x_sᵏ` (Hardy–Wright § 21.7). -/
def IsSignedSumOfPowers (k s : ℕ) (n : ℤ) : Prop :=
  ∃ x : Fin s → ℕ, ∃ ε : Fin s → ℤ, (∀ i, ε i = 1 ∨ ε i = -1) ∧ ∑ i, ε i * (x i : ℤ) ^ k = n

/-- The number `v(k)` (Hardy–Wright § 21.7): the least `s` such that every integer is a sum of `s`
members of `0, ±1ᵏ, ±2ᵏ, …`. -/
noncomputable def signedWaringNumber (k : ℕ) : ℕ := sInf {s | ∀ n : ℤ, IsSignedSumOfPowers k s n}

lemma isSignedSumOfPowers_zero (k : ℕ) : IsSignedSumOfPowers k 0 0 :=
  ⟨Fin.elim0, Fin.elim0, fun i => Fin.elim0 i, by simp⟩

lemma IsSignedSumOfPowers.add {k s t : ℕ} {m n : ℤ} (hm : IsSignedSumOfPowers k s m)
    (hn : IsSignedSumOfPowers k t n) : IsSignedSumOfPowers k (s + t) (m + n) := by
  obtain ⟨x, ε, hε, rfl⟩ := hm
  obtain ⟨y, δ, hδ, rfl⟩ := hn
  refine ⟨Fin.append x y, Fin.append ε δ, fun i => ?_, by simp [Fin.sum_univ_add]⟩
  refine Fin.addCases (fun i => ?_) (fun i => ?_) i <;> simp [hε, hδ]

lemma IsSignedSumOfPowers.mono {k s t : ℕ} {n : ℤ} (hk : k ≠ 0) (h : IsSignedSumOfPowers k s n)
    (hst : s ≤ t) : IsSignedSumOfPowers k t n := by
  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hst
  have h0 : IsSignedSumOfPowers k d 0 := ⟨fun _ => 0, fun _ => 1, fun _ => Or.inl rfl, by
    simp [zero_pow hk]⟩
  simpa using h.add h0

lemma IsSignedSumOfPowers.neg {k s : ℕ} {n : ℤ} (h : IsSignedSumOfPowers k s n) :
    IsSignedSumOfPowers k s (-n) := by
  obtain ⟨x, ε, hε, rfl⟩ := h
  refine ⟨x, fun i => -ε i, fun i => by rcases hε i with h | h <;> simp [h],
    by simp [Finset.sum_neg_distrib]⟩

lemma isSignedSumOfPowers_of_isSumOfPowers {k s : ℕ} {n : ℕ} (h : IsSumOfPowers k s n) :
    IsSignedSumOfPowers k s n := by
  obtain ⟨x, rfl⟩ := h
  exact ⟨x, fun _ => 1, fun _ => Or.inl rfl, by simp⟩

/-- `±yᵏ` is a signed `k`th power for every integer `y`. -/
lemma isSignedSumOfPowers_sign_mul_pow (k : ℕ) {e : ℤ} (he : e = 1 ∨ e = -1) (y : ℤ) :
    IsSignedSumOfPowers k 1 (e * y ^ k) := by
  have hy : y ^ k = (if 0 ≤ y then 1 else (-1) ^ k) * (y.natAbs : ℤ) ^ k := by
    split_ifs with h
    · rw [one_mul, Int.natCast_natAbs, abs_of_nonneg h]
    · rw [Int.natCast_natAbs, abs_of_neg (not_le.1 h), ← mul_pow]; ring
  have hs : (if 0 ≤ y then (1 : ℤ) else (-1) ^ k) = 1 ∨ (if 0 ≤ y then (1 : ℤ) else (-1) ^ k) = -1 := by
    split_ifs
    · exact Or.inl rfl
    · rcases neg_one_pow_eq_or ℤ k with h | h <;> simp [h]
  refine ⟨fun _ => y.natAbs, fun _ => e * (if 0 ≤ y then 1 else (-1) ^ k), fun _ => ?_, ?_⟩
  · rcases he with rfl | rfl <;> rcases hs with h | h <;> simp [h]
  · simp only [Finset.univ_unique, Fin.default_eq_zero, Finset.sum_singleton]
    rw [hy]; ring

/-- `c` copies of the same signed sum. -/
lemma IsSignedSumOfPowers.nsmul {k s : ℕ} {t : ℤ} (h : IsSignedSumOfPowers k s t) :
    ∀ c : ℕ, IsSignedSumOfPowers k (c * s) (c * t)
  | 0 => by simpa using isSignedSumOfPowers_zero k
  | c + 1 => by
    rw [Nat.succ_mul]; push_cast; rw [add_mul, one_mul]; exact (h.nsmul c).add h

/-- An integer `l` is the sum of `|l|` signed `k`th powers `±1ᵏ`. -/
lemma isSignedSumOfPowers_natAbs (k : ℕ) (l : ℤ) : IsSignedSumOfPowers k l.natAbs l := by
  have h1 := isSignedSumOfPowers_sign_mul_pow k (e := if 0 ≤ l then 1 else -1)
    (by split_ifs <;> simp) 1
  have := h1.nsmul l.natAbs
  rw [mul_one] at this
  convert this using 1
  split_ifs with h
  · simp [abs_of_nonneg h]
  · simp [abs_of_neg (not_le.1 h)]

lemma IsSignedSumOfPowers.sum_range {k : ℕ} (s : ℕ → ℕ) (f : ℕ → ℤ) :
    ∀ m : ℕ, (∀ r < m, IsSignedSumOfPowers k (s r) (f r)) →
      IsSignedSumOfPowers k (∑ r ∈ range m, s r) (∑ r ∈ range m, f r)
  | 0, _ => by simpa using isSignedSumOfPowers_zero k
  | m + 1, h => by
    rw [sum_range_succ, sum_range_succ]
    exact (IsSignedSumOfPowers.sum_range s f m fun r hr => h r (by omega)).add (h m (by omega))

/-! ### Theorems 401–403 -/

/-- **Theorem 402** (Hardy–Wright). For `k ≥ 1`,
`∑_{r=0}^{k-1} (-1)^(k-1-r) C(k-1, r) (x + r)ᵏ = k! x + d` with `d` independent of `x`. -/
@[kb "hardywright2008" "Thm 402, p. 450"]
theorem exists_sum_choose_pow_eq {k : ℕ} (hk : 1 ≤ k) : ∃ d : ℤ, ∀ x : ℤ,
    ∑ r ∈ range k, (-1 : ℤ) ^ (k - 1 - r) * ((k - 1).choose r : ℤ) * (x + r) ^ k =
      k.factorial * x + d := by
  set g : ℤ → ℤ := (fwdDiff (1 : ℤ))^[k - 1] (fun r : ℤ => r ^ k) with hg
  have hstep : ∀ x, g (x + 1) - g x = k.factorial := by
    intro x
    have h1 : fwdDiff 1 g = (fwdDiff (1 : ℤ))^[k] (fun r : ℤ => r ^ k) := by
      rw [hg, ← Function.iterate_succ_apply' (fwdDiff 1), Nat.succ_eq_add_one, Nat.sub_add_cancel hk]
    have h2 := congrFun (h1.trans fwdDiff_iter_eq_factorial) x
    simpa [fwdDiff] using h2
  have hlin : ∀ x, g x = g 0 + k.factorial * x := by
    intro x
    induction x using Int.induction_on with
    | zero => simp
    | succ n ih => have := hstep n; push_cast; linarith
    | pred n ih => have := hstep (-(n : ℤ) - 1); simp at this; push_cast; linarith
  refine ⟨g 0, fun x => ?_⟩
  have := fwdDiff_iter_eq_sum_shift (1 : ℤ) (fun r : ℤ => r ^ k) (k - 1) x
  rw [Nat.sub_add_cancel hk] at this
  rw [add_comm, ← hlin x, hg, this]
  refine sum_congr rfl fun r _ => ?_
  simp

/-- **Theorem 403** (Hardy–Wright). For `k ≥ 1`, every integer is a sum of `2^(k-1) + k!/2`
members of `0, ±1ᵏ, ±2ᵏ, …`: `v(k) ≤ 2^(k-1) + ½ k!`. -/
@[kb "hardywright2008" "Thm 403, p. 451"]
theorem isSignedSumOfPowers_two_pow_add_factorial {k : ℕ} (hk : 1 ≤ k) (n : ℤ) :
    IsSignedSumOfPowers k (2 ^ (k - 1) + k.factorial / 2) n := by
  obtain ⟨d, hd⟩ := exists_sum_choose_pow_eq hk
  have hf : (0 : ℤ) < k.factorial := by exact_mod_cast Nat.factorial_pos k
  obtain ⟨x, hx⟩ := exists_two_mul_abs_sub_le (n - d) k.factorial hf
  set l := n - d - k.factorial * x with hl
  have hsum : IsSignedSumOfPowers k (∑ r ∈ range k, (k - 1).choose r)
      (∑ r ∈ range k, (-1 : ℤ) ^ (k - 1 - r) * ((k - 1).choose r : ℤ) * (x + r) ^ k) := by
    refine IsSignedSumOfPowers.sum_range _ _ k fun r _ => ?_
    have := (isSignedSumOfPowers_sign_mul_pow k (e := (-1) ^ (k - 1 - r))
      (neg_one_pow_eq_or ℤ _ |>.imp id id) (x + r)).nsmul ((k - 1).choose r)
    rw [mul_one] at this
    convert this using 1; ring
  rw [show ∑ r ∈ range k, (k - 1).choose r = 2 ^ (k - 1) by
    rw [← Nat.sum_range_choose (k - 1), Nat.sub_add_cancel hk]] at hsum
  have hl' : IsSignedSumOfPowers k (k.factorial / 2) l := by
    refine (isSignedSumOfPowers_natAbs k l).mono (by omega) ?_
    have : 2 * (l.natAbs : ℤ) ≤ k.factorial := by rw [Int.natCast_natAbs]; exact hx
    omega
  have := hsum.add hl'
  rw [hd x] at this
  convert this using 1
  rw [hl]; ring

/-- **Theorem 401** (Hardy–Wright). `v(k)` exists for every `k ≥ 1`. -/
@[kb "hardywright2008" "Thm 401, p. 450"]
theorem exists_forall_isSignedSumOfPowers {k : ℕ} (hk : 1 ≤ k) :
    ∃ s, ∀ n : ℤ, IsSignedSumOfPowers k s n :=
  ⟨_, isSignedSumOfPowers_two_pow_add_factorial hk⟩

@[kb "hardywright2008" "Thm 403, p. 451"]
theorem signedWaringNumber_le {k : ℕ} (hk : 1 ≤ k) :
    signedWaringNumber k ≤ 2 ^ (k - 1) + k.factorial / 2 :=
  Nat.sInf_le (isSignedSumOfPowers_two_pow_add_factorial hk)

/-- **(21.8.1)** (Hardy–Wright). If all large numbers are sums of `s` `k`th powers, then every integer
is a sum of `s + 1` signed `k`th powers: `v(k) ≤ G(k) + 1`. -/
@[kb "hardywright2008" "Section 21.8, p. 451"]
theorem isSignedSumOfPowers_succ_of_eventually {k s : ℕ} (hk : 1 ≤ k)
    (hs : ∀ᶠ n in atTop, IsSumOfPowers k s n) (n : ℤ) : IsSignedSumOfPowers k (s + 1) n := by
  obtain ⟨N, hN⟩ := eventually_atTop.1 hs
  -- `n + yᵏ ≥ N` for `y = |n| + N`
  set y : ℕ := n.natAbs + N
  have hy : (N : ℤ) ≤ n + (y : ℤ) ^ k := by
    have h1 : (y : ℤ) ≤ (y : ℤ) ^ k := by
      have : (1 : ℤ) ≤ y ∨ y = 0 := by omega
      rcases this with h | h
      · exact le_self_pow₀ h (by omega)
      · rw [h]; simp
    have : (y : ℤ) = n.natAbs + N := by push_cast [y]; ring
    have := Int.natCast_natAbs n
    have := neg_abs_le n
    linarith
  have hm : IsSumOfPowers k s (n + (y : ℤ) ^ k).toNat := hN _ (by omega)
  have := (isSignedSumOfPowers_of_isSumOfPowers hm).add
    ((isSignedSumOfPowers_sign_mul_pow k (Or.inr rfl) (y : ℤ)))
  convert this using 1
  rw [Int.toNat_of_nonneg (by linarith)]; ring

@[kb "hardywright2008" "Section 21.8, p. 451"]
theorem signedWaringNumber_le_asymptoticWaringNumber_add_one {k : ℕ} (hk : 1 ≤ k)
    (hex : ∃ s, ∀ᶠ n in atTop, IsSumOfPowers k s n) :
    signedWaringNumber k ≤ asymptoticWaringNumber k + 1 :=
  Nat.sInf_le (isSignedSumOfPowers_succ_of_eventually hk
    (Nat.sInf_mem (s := {s | ∀ᶠ n in atTop, IsSumOfPowers k s n}) hex))

/-- From "every `n` is a signed sum of `b` powers" and "some `n` is not a signed sum of `a` powers"
to `a < v(k) ≤ b`. -/
lemma signedWaringNumber_mem_Ioc {k a b : ℕ} (hk : k ≠ 0) (hb : ∀ n : ℤ, IsSignedSumOfPowers k b n)
    (ha : ∃ n : ℤ, ¬ IsSignedSumOfPowers k a n) : a < signedWaringNumber k ∧ signedWaringNumber k ≤ b := by
  refine ⟨?_, Nat.sInf_le hb⟩
  by_contra h
  push Not at h
  obtain ⟨n, hn⟩ := ha
  exact hn ((Nat.sInf_mem (s := {s | ∀ n : ℤ, IsSignedSumOfPowers k s n}) ⟨b, hb⟩ n).mono hk h)

/-! ### Theorem 404: squares -/

/-- **Theorem 404** (Hardy–Wright). `v(2) = 3`. -/
@[kb "hardywright2008" "Thm 404, p. 452"]
theorem signedWaringNumber_two : signedWaringNumber 2 = 3 := by
  have hb : ∀ n : ℤ, IsSignedSumOfPowers 2 3 n := by
    intro n
    rcases Int.emod_two_eq_zero_or_one n with h | h
    · -- `2x = x² - (x - 1)² + 1²`
      obtain ⟨x, hx⟩ : ∃ x, n = 2 * x := ⟨n / 2, by omega⟩
      have := ((isSignedSumOfPowers_sign_mul_pow 2 (Or.inl rfl) x).add
        (isSignedSumOfPowers_sign_mul_pow 2 (Or.inr rfl) (x - 1))).add
        (isSignedSumOfPowers_sign_mul_pow 2 (Or.inl rfl) 1)
      convert this using 1; rw [hx]; ring
    · -- `2x + 1 = (x + 1)² - x²`
      obtain ⟨x, hx⟩ : ∃ x, n = 2 * x + 1 := ⟨n / 2, by omega⟩
      have := ((isSignedSumOfPowers_sign_mul_pow 2 (Or.inl rfl) (x + 1)).add
        (isSignedSumOfPowers_sign_mul_pow 2 (Or.inr rfl) x)).mono two_ne_zero (Nat.le_succ 2)
      convert this using 1; rw [hx]; ring
  have ha : ¬ IsSignedSumOfPowers 2 2 6 := by
    rintro ⟨x, ε, hε, hx⟩
    rw [Fin.sum_univ_two] at hx
    have key : ∀ a b : ZMod 8, a ^ 2 + b ^ 2 ≠ 6 ∧ a ^ 2 - b ^ 2 ≠ 6 ∧ -a ^ 2 + b ^ 2 ≠ 6 := by
      decide
    have h8 := congrArg (fun z : ℤ => (z : ZMod 8)) hx
    push_cast at h8
    rcases hε 0 with h0 | h0 <;> rcases hε 1 with h1 | h1 <;> rw [h0, h1] at h8 hx
    · exact (key _ _).1 (by simpa using h8)
    · exact (key _ _).2.1 (by simpa [sub_eq_add_neg] using h8)
    · exact (key _ _).2.2 (by simpa using h8)
    · have := sq_nonneg (x 0 : ℤ); have := sq_nonneg (x 1 : ℤ); linarith
  have := signedWaringNumber_mem_Ioc two_ne_zero hb ⟨6, ha⟩
  omega

/-! ### Theorem 405: cubes -/

/-- **Theorem 405** (Hardy–Wright). `v(3)` is `4` or `5`. -/
@[kb "hardywright2008" "Thm 405, p. 453"]
theorem signedWaringNumber_three : signedWaringNumber 3 = 4 ∨ signedWaringNumber 3 = 5 := by
  have hb : ∀ n : ℤ, IsSignedSumOfPowers 3 5 n := by
    intro n
    -- `n³ - n = 6x`, `n = n³ - (x + 1)³ - (x - 1)³ + x³ + x³`
    obtain ⟨x, hx⟩ : (6 : ℤ) ∣ n ^ 3 - n := by
      have : n ^ 3 - n = (n - 1) * n * (n + 1) := by ring
      rw [this]
      have h2 : (2 : ℤ) ∣ (n - 1) * n * (n + 1) := by
        rcases Int.emod_two_eq_zero_or_one n with h | h
        · exact Dvd.dvd.mul_right (Dvd.dvd.mul_left (Int.dvd_of_emod_eq_zero h) _) _
        · exact Dvd.dvd.mul_right (Dvd.dvd.mul_right (Int.dvd_of_emod_eq_zero (by omega)) _) _
      have h3 : (3 : ℤ) ∣ (n - 1) * n * (n + 1) := by
        have : n % 3 = 0 ∨ n % 3 = 1 ∨ n % 3 = 2 := by omega
        rcases this with h | h | h
        · exact Dvd.dvd.mul_right (Dvd.dvd.mul_left (Int.dvd_of_emod_eq_zero h) _) _
        · exact Dvd.dvd.mul_right (Dvd.dvd.mul_right (Int.dvd_of_emod_eq_zero (by omega)) _) _
        · exact Dvd.dvd.mul_left (Int.dvd_of_emod_eq_zero (by omega)) _
      exact IsCoprime.mul_dvd (by norm_num) h2 h3
    have := ((((isSignedSumOfPowers_sign_mul_pow 3 (Or.inl rfl) n).add
      (isSignedSumOfPowers_sign_mul_pow 3 (Or.inr rfl) (x + 1))).add
      (isSignedSumOfPowers_sign_mul_pow 3 (Or.inr rfl) (x - 1))).add
      (isSignedSumOfPowers_sign_mul_pow 3 (Or.inl rfl) x)).add
      (isSignedSumOfPowers_sign_mul_pow 3 (Or.inl rfl) x)
    convert this using 1
    linear_combination -hx
  have ha : ¬ IsSignedSumOfPowers 3 3 4 := by
    rintro ⟨x, ε, hε, hx⟩
    rw [Fin.sum_univ_three] at hx
    -- `±y³ = (±y)³`, and cubes are `0, ±1 (mod 9)`
    have key : ∀ a b c : ZMod 9, a ^ 3 + b ^ 3 + c ^ 3 ≠ 4 := by decide
    have hc : ∀ i, ε i * (x i : ℤ) ^ 3 = (ε i * x i) ^ 3 := fun i => by
      rcases hε i with h | h <;> rw [h] <;> ring
    rw [hc, hc, hc] at hx
    have h9 := congrArg (fun z : ℤ => (z : ZMod 9)) hx
    push_cast at h9
    exact key _ _ _ h9
  have := signedWaringNumber_mem_Ioc three_ne_zero hb ⟨4, ha⟩
  omega

/-! ### Theorem 406: biquadrates -/

/-- **(21.8.2)** (Hardy–Wright). `(x + 3)⁴ - 3(x + 2)⁴ + 3(x + 1)⁴ - x⁴ = 24x + 36`. -/
lemma biquadrate_difference (x : ℤ) :
    (x + 3) ^ 4 - 3 * (x + 2) ^ 4 + 3 * (x + 1) ^ 4 - x ^ 4 = 24 * x + 36 := by ring

/-- Every residue `(mod 24)` is a sum of four of `0, ±1⁴, ±2⁴, ±3⁴`. -/
lemma exists_signed_biquadrates_mod_24 (r : ℕ) (hr : r < 24) :
    ∃ e : Fin 4 → ℤ, ∃ y : Fin 4 → ℕ, (∀ i, e i = 1 ∨ e i = -1) ∧
      (∑ i, e i * (y i : ℤ) ^ 4) % 24 = r := by
  interval_cases r
  · exact ⟨![1, 1, 1, 1], ![0, 0, 0, 0], by decide, by decide⟩
  · exact ⟨![1, 1, 1, 1], ![0, 0, 0, 1], by decide, by decide⟩
  · exact ⟨![1, 1, 1, 1], ![0, 0, 1, 1], by decide, by decide⟩
  · exact ⟨![1, 1, 1, 1], ![0, 1, 1, 1], by decide, by decide⟩
  · exact ⟨![1, 1, 1, 1], ![1, 1, 1, 1], by decide, by decide⟩
  · exact ⟨![1, -1, -1, -1], ![0, 1, 3, 3], by decide, by decide⟩
  · exact ⟨![1, 1, -1, -1], ![0, 0, 3, 3], by decide, by decide⟩
  · exact ⟨![1, 1, -1, -1], ![0, 0, 1, 2], by decide, by decide⟩
  · exact ⟨![1, 1, 1, -1], ![0, 0, 0, 2], by decide, by decide⟩
  · exact ⟨![1, 1, 1, 1], ![0, 0, 0, 3], by decide, by decide⟩
  · exact ⟨![1, 1, 1, 1], ![0, 0, 1, 3], by decide, by decide⟩
  · exact ⟨![1, 1, 1, 1], ![0, 1, 1, 3], by decide, by decide⟩
  · exact ⟨![1, 1, 1, 1], ![1, 1, 1, 3], by decide, by decide⟩
  · exact ⟨![1, -1, -1, -1], ![0, 1, 1, 3], by decide, by decide⟩
  · exact ⟨![1, 1, -1, -1], ![0, 0, 1, 3], by decide, by decide⟩
  · exact ⟨![1, 1, 1, -1], ![0, 0, 0, 3], by decide, by decide⟩
  · exact ⟨![1, 1, 1, 1], ![0, 0, 0, 2], by decide, by decide⟩
  · exact ⟨![1, 1, 1, 1], ![0, 0, 1, 2], by decide, by decide⟩
  · exact ⟨![1, 1, 1, 1], ![0, 0, 3, 3], by decide, by decide⟩
  · exact ⟨![1, 1, 1, 1], ![0, 1, 3, 3], by decide, by decide⟩
  · exact ⟨![1, 1, 1, 1], ![1, 1, 3, 3], by decide, by decide⟩
  · exact ⟨![1, -1, -1, -1], ![0, 1, 1, 1], by decide, by decide⟩
  · exact ⟨![1, 1, -1, -1], ![0, 0, 1, 1], by decide, by decide⟩
  · exact ⟨![1, 1, 1, -1], ![0, 0, 0, 1], by decide, by decide⟩

/-- **Theorem 406** (Hardy–Wright). `9 ≤ v(4) ≤ 12`. -/
@[kb "hardywright2008" "Thm 406, p. 453"]
theorem signedWaringNumber_four : 9 ≤ signedWaringNumber 4 ∧ signedWaringNumber 4 ≤ 12 := by
  have hb : ∀ n : ℤ, IsSignedSumOfPowers 4 12 n := by
    intro n
    obtain ⟨e, y, he, hr⟩ := exists_signed_biquadrates_mod_24 ((n - 36) % 24).toNat (by omega)
    have hr' : (∑ i, e i * (y i : ℤ) ^ 4) % 24 = (n - 36) % 24 := by
      rw [hr, Int.toNat_of_nonneg (Int.emod_nonneg _ (by norm_num))]
    obtain ⟨x, hx⟩ : ∃ x, n - ∑ i, e i * (y i : ℤ) ^ 4 = 24 * x + 36 :=
