        intro i
        have := h1 i
        simp only [hu] at this
        split_ifs at this with h
        · exact ⟨h, this⟩
        · exact absurd this (by norm_num)
      have hge : ∀ i, (1 : ℤ) ≤ (x i : ℤ) ^ 4 := fun i => by
        have : 1 ≤ x i := by have := (hodd i).1; omega
        exact one_le_pow₀ (by exact_mod_cast this)
      simp only [(hodd _).2, one_mul] at hx
      -- each term is `1`, since a term `≥ 81` would make the sum exceed `24`
      have hone : ∀ i, (x i : ℤ) ^ 4 = 1 := by
        intro i
        by_contra hne
        have hxi : 2 ≤ x i := by
          by_contra h
          have : x i = 1 := by have := (hodd i).1; omega
          exact hne (by simp [this])
        have : (16 : ℤ) ≤ (x i : ℤ) ^ 4 := by
          have : ((2 : ℕ) : ℤ) ^ 4 ≤ (x i : ℤ) ^ 4 := pow_le_pow_left₀ (by norm_num) (by exact_mod_cast hxi) 4
          simpa using this
        have : (x i : ℤ) ^ 4 + 7 ≤ ∑ j, (x j : ℤ) ^ 4 := by
          rw [← Finset.add_sum_erase _ _ (mem_univ i)]
          have : (7 : ℤ) ≤ ∑ j ∈ univ.erase i, (x j : ℤ) ^ 4 := by
            calc (7 : ℤ) = ∑ _j ∈ univ.erase i, (1 : ℤ) := by simp [Finset.card_erase_of_mem]
              _ ≤ _ := sum_le_sum fun j _ => hge j
          linarith
        -- `x i` odd and `≥ 2` gives `x i ≥ 3`, so `x i ^ 4 ≥ 81`
        have hxi3 : 3 ≤ x i := by have := (hodd i).1; omega
        have : ((3 : ℕ) : ℤ) ^ 4 ≤ (x i : ℤ) ^ 4 := pow_le_pow_left₀ (by norm_num) (by exact_mod_cast hxi3) 4
        norm_num at this
        linarith
      simp [hone] at hx
    · have h1 := hall (fun i => -u i) (fun i => by have := (hub i).1; linarith)
        (by rw [Finset.sum_neg_distrib, hS]; norm_num)
      have hneg : ∀ i, ε i = -1 := by
        intro i
        have := h1 i
        simp only [hu] at this
        split_ifs at this
        · linarith
        · norm_num at this
      simp only [hneg, neg_one_mul, Finset.sum_neg_distrib] at hx
      have : (0 : ℤ) ≤ ∑ i, (x i : ℤ) ^ 4 := sum_nonneg fun i _ => by positivity
      linarith
  have := signedWaringNumber_mem_Ioc (by norm_num) hb ⟨24, ha⟩
  omega

