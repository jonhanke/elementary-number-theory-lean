      rw [← biquadrate_difference]
      have h3 := (isSignedSumOfPowers_sign_mul_pow 4 (Or.inr rfl) (x + 2)).nsmul 3
      have h3' := (isSignedSumOfPowers_sign_mul_pow 4 (Or.inl rfl) (x + 1)).nsmul 3
      have := (((isSignedSumOfPowers_sign_mul_pow 4 (Or.inl rfl) (x + 3)).add h3).add h3').add
        (isSignedSumOfPowers_sign_mul_pow 4 (Or.inr rfl) x)
      convert this using 1; push_cast; ring
    have h4 : IsSignedSumOfPowers 4 4 (∑ i, e i * (y i : ℤ) ^ 4) := ⟨y, e, he, rfl⟩
    convert h8.add h4 using 1
    linarith
