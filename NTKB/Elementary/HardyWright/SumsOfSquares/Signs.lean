lemma fifthPowerTable_spec : (List.range 720).all (fun r =>
    ((fifthPowerTable.getD r (0, 0)).1 ^ 5 + (fifthPowerTable.getD r (0, 0)).2 ^ 5) % 720 == r) =
    true := by
  decide +kernel

/-- Every residue `(mod 720)` is the sum of two fifth power residues (Hardy–Wright § 21.8 (4)). -/
lemma exists_fifth_powers_mod_720 (r : ℕ) (hr : r < 720) :
    ∃ a b : ℕ, (a ^ 5 + b ^ 5) % 720 = r := by
  have := List.all_eq_true.1 fifthPowerTable_spec r (List.mem_range.2 hr)
  exact ⟨_, _, by simpa using this⟩

/-- **Theorem 407** (Hardy–Wright). `5 ≤ v(5) ≤ 10`. -/
@[kb "hardywright2008" "Thm 407, p. 454"]
theorem signedWaringNumber_five : 5 ≤ signedWaringNumber 5 ∧ signedWaringNumber 5 ≤ 10 := by
  have hb : ∀ n : ℤ, IsSignedSumOfPowers 5 10 n := by
    intro n
    obtain ⟨a, b, hab⟩ := exists_fifth_powers_mod_720 ((n + 360) % 720).toNat (by omega)
    have hab' : ((a : ℤ) ^ 5 + (b : ℤ) ^ 5) % 720 = (n + 360) % 720 := by
      have : (((a ^ 5 + b ^ 5) % 720 : ℕ) : ℤ) = (((n + 360) % 720).toNat : ℤ) := by rw [hab]
      push_cast at this
      rw [this, Int.toNat_of_nonneg (Int.emod_nonneg _ (by norm_num))]
    obtain ⟨x, hx⟩ : ∃ x, n - (a : ℤ) ^ 5 - (b : ℤ) ^ 5 = 720 * x - 360 :=
      ⟨(n - (a : ℤ) ^ 5 - (b : ℤ) ^ 5 + 360) / 720, by omega⟩
    have h8 : IsSignedSumOfPowers 5 8 (720 * x - 360) := by
      rw [← fifth_power_difference]
      have h2 := (isSignedSumOfPowers_sign_mul_pow 5 (Or.inr rfl) (x + 2)).nsmul 2
      have h2' := (isSignedSumOfPowers_sign_mul_pow 5 (Or.inr rfl) (x - 3)).nsmul 2
      have := (((((isSignedSumOfPowers_sign_mul_pow 5 (Or.inl rfl) (x + 3)).add h2).add
        (isSignedSumOfPowers_sign_mul_pow 5 (Or.inl rfl) x)).add
        (isSignedSumOfPowers_sign_mul_pow 5 (Or.inl rfl) (x - 1))).add h2').add
        (isSignedSumOfPowers_sign_mul_pow 5 (Or.inl rfl) (x - 4))
      convert this using 1; push_cast; ring
    have h2 := (isSignedSumOfPowers_sign_mul_pow 5 (Or.inl rfl) (a : ℤ)).add
      (isSignedSumOfPowers_sign_mul_pow 5 (Or.inl rfl) (b : ℤ))
    convert h8.add h2 using 1
    linarith
  have ha : ¬ IsSignedSumOfPowers 5 4 5 := by
    rintro ⟨x, ε, hε, hx⟩
    rw [Fin.sum_univ_four] at hx
    have key : ∀ a b c d : ZMod 11, a ^ 5 + b ^ 5 + c ^ 5 + d ^ 5 ≠ 5 := by decide
    have hc : ∀ i, ε i * (x i : ℤ) ^ 5 = (ε i * x i) ^ 5 := fun i => by
      rcases hε i with h | h <;> rw [h] <;> ring
    rw [hc, hc, hc, hc] at hx
    have h11 := congrArg (fun z : ℤ => (z : ZMod 11)) hx
    push_cast at h11
    exact key _ _ _ _ h11
  have := signedWaringNumber_mem_Ioc (by norm_num) hb ⟨5, ha⟩
  omega

