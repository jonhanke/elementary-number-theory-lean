    have hall : ∀ v : Fin 8 → ℤ, (∀ i, v i ≤ 1) → ∑ i, v i = 8 → ∀ i, v i = 1 := by
      intro v hle hsum i
      by_contra hne
      have hi : v i ≤ 0 := by have := hle i; omega
      have e := Finset.add_sum_erase univ v (mem_univ i)
