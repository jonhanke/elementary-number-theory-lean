  have ha : ¬ IsSignedSumOfPowers 4 8 24 := by
    rintro ⟨x, ε, hε, hx⟩
    have hmod : ∀ y : ℕ, (y % 2 = 0 ∧ (y : ℤ) ^ 4 % 16 = 0) ∨ (y % 2 = 1 ∧ (y : ℤ) ^ 4 % 16 = 1) := by
      intro y
      rcases pow_two_pow_mod (θ := 2) le_rfl y with ⟨h, h'⟩ | ⟨h, h'⟩
      · exact Or.inl ⟨h, by exact_mod_cast h'⟩
      · exact Or.inr ⟨h, by exact_mod_cast h'⟩
    -- `u i = ε i` for odd `x i` and `0` otherwise; the sum is `≡ ∑ u (mod 16)`
    set u : Fin 8 → ℤ := fun i => if x i % 2 = 1 then ε i else 0 with hu
    have hcong : ∀ i, ε i * (x i : ℤ) ^ 4 ≡ u i [ZMOD 16] := by
      intro i
      rcases hmod (x i) with ⟨h, h'⟩ | ⟨h, h'⟩
      · simp only [hu]
        rw [ite_eq_right_iff.2 (fun h => by omega)]
        exact Int.modEq_zero_iff_dvd.2 (Dvd.dvd.mul_left (Int.dvd_of_emod_eq_zero h') _)
      · simp only [hu]
        rw [ite_eq_left_iff.2 (fun h' => absurd h h')]
        have : (x i : ℤ) ^ 4 ≡ 1 [ZMOD 16] := by unfold Int.ModEq; rw [h']; rfl
        simpa using this.mul_left (ε i)
    have hsum : (24 : ℤ) ≡ ∑ i, u i [ZMOD 16] := by
      rw [← hx]; exact Int.ModEq.sum fun i _ => hcong i
    have hub : ∀ i, -1 ≤ u i ∧ u i ≤ 1 := by
      intro i; simp only [hu]; split_ifs <;> rcases hε i with h | h <;> simp [h]
    have hS1 : ∑ i, u i ≤ 8 := by
      calc ∑ i, u i ≤ ∑ _i : Fin 8, (1 : ℤ) := sum_le_sum fun i _ => (hub i).2
        _ = 8 := by simp
    have hS2 : -8 ≤ ∑ i, u i := by
      calc (-8 : ℤ) = ∑ _i : Fin 8, (-1 : ℤ) := by simp
        _ ≤ ∑ i, u i := sum_le_sum fun i _ => (hub i).1
    have hS : ∑ i, u i = 8 ∨ ∑ i, u i = -8 := by
      have := Int.ModEq.dvd hsum
      omega
